ALLOWED_STATUSES = {'backlog', 'ready', 'blocked', 'awaiting_human', 'done'}
ALLOWED_EXECUTORS = {'agent', 'human'}
ALLOWED_RUNNERS = {'any', 'linux', 'macos', 'windows'}
