{
  "name": "Photo Cut · Flutter 3.47.2",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "FLUTTER_VERSION": "3.47.2",
      "FLUTTER_SHA256": "447878859d01ca9bfdb99a85f245af07ed8a15fedcd9d189c4749e8e92d1f185"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "dart.lineLength": 100
      }
    }
  },
  "postCreateCommand": "flutter config --no-analytics && flutter pub get && python3 tool/project.py doctor"
}
