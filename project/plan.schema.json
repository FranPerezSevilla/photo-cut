{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FranPerezSevilla/photo-cut/blob/main/project/plan.schema.json",
  "title": "Photo Cut implementation plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "currentMilestone",
    "milestones",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "const": "photo-cut"
    },
    "currentMilestone": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "title",
        "goal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "command",
        "runner"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "runner": {
          "enum": [
            "any",
            "linux",
            "macos",
            "windows"
          ]
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "milestone",
        "title",
        "status",
        "executor",
        "dependsOn",
        "objective",
        "acceptance",
        "checks",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]+-[TH][0-9]+$"
        },
        "milestone": {
          "type": "string",
          "pattern": "^M[0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "backlog",
            "ready",
            "blocked",
            "awaiting_human",
            "done"
          ]
        },
        "executor": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objective": {
          "type": "string"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
